# Path to the SQLite database file.
# Local dev: leave blank — the app defaults to ../ksamata_funnels.db (repo root),
#   assuming process.cwd() is app/ (true for both `next dev` and `npx tsx` scripts).
# Production / Docker: set to an absolute path, e.g. /data/ksamata_funnels.db
FUNNELS_DB_PATH=

# ── Dokploy / Docker deployment ──────────────────────────────────────────────
# In Dokploy, set the following environment variable:
#   FUNNELS_DB_PATH=/data/ksamata_funnels.db
#
# Mount a persistent volume at /data inside the container.
# On first start the entrypoint script (docker-entrypoint.sh) automatically
# copies the baked-in seed DB to /data/ksamata_funnels.db if it does not
# already exist.  Subsequent restarts skip the copy — your data is preserved.
# ─────────────────────────────────────────────────────────────────────────────

# ── Учётки редакторов (src/lib/auth.ts, src/middleware.ts) ───────────────────
# Модель доступа: список воронок и карточки читает кто угодно без входа;
# справочники, теги, мониторинг, экспорт и ЛЮБОЕ изменение — только по входу.
#
# Пары "имя:пароль", разделённые запятой или переводом строки. Делится по
# первому двоеточию, так что двоеточие в пароле допустимо, а запятая и перенос
# строки — нет (это разделители записей). Обрезаются края всей записи целиком
# и, отдельно, само имя — но не пароль: пробел сразу после ":" попадёт в пароль
# как есть, поэтому не ставь его там. Повтор имени в списке: побеждает первая
# запись, вторая тихо игнорируется.
# Пустое значение = вход не настроен: в проде запись отвечает 503, локально всё
# открыто (как было раньше при пустом ADMIN_BASIC_AUTH).
#   ADMIN_USERS=sergei:change-me,masha:change-me-too
ADMIN_USERS=

# Ключ подписи cookie сессии. В ПРОДЕ ОБЯЗАТЕЛЕН: без него войти нельзя и любая
# запись отвечает 503 (чтение продолжает работать). Минимум 16 символов —
# слабый ключ означает подделываемую сессию, то есть право записи для всех.
# Смена значения разлогинивает всех сразу. Локально можно не задавать: вне
# прода ключ выводится из ADMIN_USERS.
#   openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Публичное чтение (src/lib/auth.ts) ───────────────────────────────────────
# По умолчанию включено. Выключает ровно строка "false" — тогда сервис
# возвращается к прежней модели «всё под авторизацией», без выката кода.
#   PUBLIC_READ_ENABLED=false
PUBLIC_READ_ENABLED=

# ── Совместимость: одиночная учётка Basic (src/middleware.ts) ────────────────
# Больше ничего не закрывает — чтение публично в любом случае. Продолжает
# работать как ещё один ключ на запись, удобный для curl и скриптов.
# Формат прежний, "user:password". Новые учётки заводи в ADMIN_USERS.
#   ADMIN_BASIC_AUTH=admin:change-me
ADMIN_BASIC_AUTH=

# ── Kill-switch: turn auth OFF entirely (src/middleware.ts) ───────────────────
# Set to exactly "true" to disable auth EVERYWHERE — including production and
# even when ADMIN_USERS is set. Every page and API route becomes publicly
# reachable AND EDITABLE by anyone. Only "true" disables; any other value keeps
# auth on. Remove this variable to restore normal behaviour.
# WARNING: on a public URL this hands the editor to anyone who finds the URL.
#   ADMIN_AUTH_DISABLED=true
ADMIN_AUTH_DISABLED=

# ── Мониторинг доступности лендов ────────────────────────────────────────────
# Фоновые проверки поднимаются вместе с сервером (src/instrumentation.ts).
# Выключает ровно строка "false" — любое другое значение оставляет мониторинг включённым.
# Локально имеет смысл выключить, чтобы dev-сервер не ходил на боевые ленды.
#   MONITOR_ENABLED=false
MONITOR_ENABLED=

# Период цикла проверок в минутах. По умолчанию 15. Мусор и неположительные
# значения игнорируются — берётся значение по умолчанию.
MONITOR_INTERVAL_MINUTES=
